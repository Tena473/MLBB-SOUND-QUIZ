{
  "name": "mlbb-sound-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "prepare:sounds": "node scripts/prepare-sounds.mjs",
    "normalize:sounds:check": "node scripts/normalize-sounds.mjs",
    "normalize:sounds": "node scripts/normalize-sounds.mjs --apply",
    "sync:portraits": "node scripts/sync-portraits.mjs",
    "predev": "npm run prepare:sounds",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:sounds",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pretest": "npm run prepare:sounds",
    "test": "vitest run",
    "test:watch": "npm run prepare:sounds && vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
